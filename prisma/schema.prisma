generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HOST
  GUEST
}

enum ListingType {
  APARTMENT
  HOUSE
  VILLA
  CABIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  username  String   @unique
  password  String   @map("passwordHash")
  phone     String
  role      Role     @default(GUEST)
  avatar    String?
  avatarPublicId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  resetToken String?
  resetTokenExpiry DateTime?

  listings  Listing[] @relation("HostListings")
  bookings  Booking[] @relation("GuestBookings")
  reviews   Review[] @relation("UserReviews")
  profile   Profile?

  @@index([name])
  @@index([role])
}

model Listing {
  id            String      @id @default(uuid())
  title         String
  description   String
  location      String
  pricePerNight Float
  guests        Int
  type          ListingType
  amenities     String[]
  rating        Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  hostId   String
  host     User       @relation("HostListings", fields: [hostId], references: [id], onDelete: Cascade)

  bookings Booking[]
  photos   ListingPhoto[]
  reviews  Review[]  @relation("ListingReviews")

  @@index([hostId])
  @@index([location])
  @@index([type])
  @@index([pricePerNight])
}

model Booking {
  id         String        @id @default(uuid())
  checkIn    DateTime
  checkOut   DateTime
  guests     Int
  total      Float
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now())

  userId String
  user   User   @relation("GuestBookings", fields: [userId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([listingId])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation("ListingReviews", fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([userId])
}

model Profile {
  id      String  @id @default(uuid())
  bio     String?
  website String?
  country String?

  userId String  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ListingPhoto {
  id        String   @id @default(uuid())
  url       String
  publicId  String?
  createdAt DateTime @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

